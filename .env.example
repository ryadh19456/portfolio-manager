# SQLite database file used by the portfolio app.
# This project defaults to a local SQLite database so no Postgres service is required.

# Admin unlock settings used by app/actions/auth.ts
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Email delivery for the contact form (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Optional: if your app is hosted in a blob or static environment, set this as needed.
# NEXT_PUBLIC_SITE_URL=
