# Required on Vercel for persistent portfolio content and image uploads.
BLOB_READ_WRITE_TOKEN=

# Local development stores content in lib/db/json/site_content.json.

# Admin unlock settings used by app/actions/auth.ts
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Email delivery for the contact form (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Set this to the canonical public origin (without a trailing path), e.g. https://example.com.
NEXT_PUBLIC_SITE_URL=
